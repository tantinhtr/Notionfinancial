{
  "name": "notion-finance-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UPDATE_COORDINATOR",
        "class_name": "UpdateCoordinator"
      }
    ]
  },
  "exports": {
    "UpdateCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "760671f08e634e8eafd981e6dfe9ffdb"
    }
  ],
  "triggers": {
    "crons": ["0 14 * * *"]
  },
  "vars": {
    "ALLOWED_USER_ID": "7429683600"
  }
}
